# Copy to .env and fill in values. Never commit .env.

# Port the Express server listens on.
PORT=3000

# Google Gemini API key. Server-side only; never put this in frontend code.
GEMINI_API_KEY=

# Gemini model used for plan generation.
GEMINI_MODEL=gemini-3.5-flash-lite

# Maximum time in milliseconds to wait for a Gemini response.
AI_TIMEOUT_MS=30000

# Planning requests allowed per IP inside the window.
PLAN_RATE_MAX=10
PLAN_RATE_WINDOW_MS=900000

# Browser origins allowed to call this API. Only the two Firebase Hosting origins
# are accepted; any other value is ignored. Leave unset for local development,
# where the page and API share one origin.
ALLOWED_ORIGINS=https://celebrate-ai-promptwars.web.app,https://celebrate-ai-promptwars.firebaseapp.com

# Public https origin of the hosted API. Read only by scripts/prepare-firebase-hosting.js
# when publishing Firebase Hosting. Leave this unset until the Vercel URL exists.
# The Express server does not use it, and it is not a secret.
# API_BASE_URL=https://your-project.vercel.app
