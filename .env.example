# Copy to .env and fill in values. Never commit .env.

# Port the Express server listens on.
PORT=3000

# Not used by the dashboard or Firebase Hosting. Do not put this value in frontend code.
# The lines below remain only for the local Express process.
GEMINI_API_KEY=

# Gemini model used by the local Express process. The dashboard uses firebasePublicConfig.js.
GEMINI_MODEL=gemini-3.5-flash-lite

# Maximum time in milliseconds for the local Express Gemini call.
AI_TIMEOUT_MS=30000

# Planning requests allowed per IP inside the window for the local Express routes.
PLAN_RATE_MAX=10
PLAN_RATE_WINDOW_MS=900000

# Ignored by the dashboard. Hosting does not call the Express API.
ALLOWED_ORIGINS=https://celebrate-ai-promptwars.web.app,https://celebrate-ai-promptwars.firebaseapp.com
